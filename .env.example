# ── Required ─────────────────────────────────────────────────────────────────

# Your TorBox API token (torbox.app → Settings → API key).
TORBOX_KEY=

# The unguessable path segment in front of every route. The addon URL you paste
# into BitChord is https://<host>/<PATH_SECRET>. Generate one with:
#   openssl rand -hex 24
PATH_SECRET=change-me-to-a-long-random-string

# The hostname(s) the addon is reached at, comma separated. Hostname only —
# no scheme, no port, no path. The BitChord auth verifier signs over this exact
# value, so a wrong entry shows up in the logs as `invalid_proof`.
PUBLIC_HOSTS=addon.example.com

# The hostname Caddy should serve TLS for (used by docker-compose, not the app).
ADDON_DOMAIN=addon.example.com

# ── Optional ─────────────────────────────────────────────────────────────────

# PORT=8099
# BIND_HOST=127.0.0.1
# DB_PATH=./data/index.db
# LOG_LEVEL=info

# Acquisition: find releases for tracks the account does not hold.
# ACQUIRE_ENABLED=1
# Uncached adds are throttled by TorBox to 60/hour and can be dead on arrival,
# so they are skipped by default. Set to 1 to let the queue download them.
# ACQUIRE_UNCACHED=0
# MAX_ALBUMS_PER_HOUR=6
# MIN_SEEDERS=1
# MAX_ALBUM_GB=8

# Escape hatch, off by default: serve audio through this server instead of handing
# over TorBox's presigned URL. Direct is preferred — BitChord plays third-party
# URLs itself (that is how every TorBox and Qobuz addon works) and a proxy costs
# this host the bandwidth of every stream. Enable only if a future TorBox CDN
# change makes the direct link unplayable. MEDIA_SECRET is required when enabled;
# signed links expire after MEDIA_TTL_SECONDS (default 30 min).
# MEDIA_PROXY=0
# MEDIA_SECRET=
# MEDIA_TTL_SECONDS=1800

# How many files the prober reads per run, and how many bytes it may read from
# each. 512 KiB covers STREAMINFO plus a Vorbis comment without pulling artwork.
# PROBE_BATCH=40
# PROBE_MAX_BYTES=524288

# How often the whole library is re-walked, in minutes (0 = boot only).
# SYNC_INTERVAL_MINUTES=360
