# Caddy configuration for the BitChord addon.
#
# Caddy obtains and renews a Let's Encrypt certificate on its own, so the addon URL
# is HTTPS with a certificate BitChord will accept — a self-signed certificate is
# rejected by the app, which is why the proxy (not the app) terminates TLS.
#
# The addon itself never listens on a public interface; it is reachable only from
# this process over the compose network.

{$ADDON_DOMAIN} {
	encode zstd gzip

	# The protocol is GET-only and nothing uploads, so cap request bodies hard.
	request_body {
		max_size 1MB
	}

	reverse_proxy addon:8099 {
		# A cold acquisition inside /stream can legitimately take ~25s.
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
	}

	log {
		output stdout
		format console
		level INFO
	}
}
